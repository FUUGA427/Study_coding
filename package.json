{
  "name": "learning-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/frontend",
    "build": "npm run build --workspace packages/shared-types && npm run build --workspace apps/frontend",
    "lint": "npm run lint --workspace apps/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "backend:dev": "cd apps/backend && uvicorn app.main:app --reload",
    "backend:test": "cd apps/backend && pytest"
  },
  "engines": {
    "node": ">=20"
  }
}
